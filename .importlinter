# logline speaks ASGI and nothing else: it imports no web framework, server or HTTP client, so
# every host can take it. quality's CI gate checks the contracts over the real import graph.
[importlinter]
include_external_packages = True
root_packages =
    logline

[importlinter:contract:logline-imports-no-web-framework]
name = logline imports no web framework, server or HTTP client
type = forbidden
source_modules =
    logline
forbidden_modules =
    fastapi
    starlette
    uvicorn
    httpx
    httpx2
    httpcore
    httpcore2
    websockets

[importlinter:contract:logline-check-imports-only-the-standard-library-and-standard]
name = logline.check imports only the standard library and logline.standard
type = forbidden
source_modules =
    logline.check
forbidden_modules =
    structlog
    opentelemetry
    logline.*
ignore_imports =
    logline.check -> logline.standard

[importlinter:contract:logline-standard-imports-only-the-standard-library]
name = logline.standard imports only the standard library
type = forbidden
source_modules =
    logline.standard
forbidden_modules =
    structlog
    opentelemetry
    logline.*

[importlinter:contract:no-runtime-module-imports-logline-check]
name = no runtime module imports logline.check
type = forbidden
as_packages = False
source_modules =
    logline
    logline.*
forbidden_modules =
    logline.check
